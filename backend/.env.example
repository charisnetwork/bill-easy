# ======================================
# Bill Easy Backend — Environment Variables
# ======================================
# Copy this file to .env and fill in your values.

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@localhost:5432/billeasy

# ---------- Authentication ----------
JWT_SECRET=your-random-64-character-secret-string
JWT_ACCESS_SECRET=your-random-64-character-access-secret

# ---------- Server ----------
PORT=8001
NODE_ENV=development

# ---------- Razorpay Payment Gateway ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# ---------- Charis Control Centre ----------
CONTROL_CENTER_URL=https://chariscontrol-production.up.railway.app
CONTROL_CENTER_API_KEY=
CONTROL_CENTER_APPLICATION_ID=
CONTROL_CENTER_PUBLIC_KEY=
CONTROL_CENTER_WEBHOOK_SECRET=
CONTROL_CENTER_INTEGRATION_KEY=

# ---------- Cloudinary (Asset Storage) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Google Cloud Storage (Asset Storage) ----------
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=bill-easy-assets

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@charisbilleasy.store
SUPPORT_EMAIL=support@charisbilleasy.store

# ---------- CORS ----------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6000

# ---------- Admin ----------
ADMIN_SECRET_PIN=

# ---------- Google AI (Charis Assistant) ----------
GEMINI_API_KEY=
