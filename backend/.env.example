# ======================================
# Bill Easy Backend — Environment Variables
# ======================================
# Copy this file to .env and fill in your values. Never commit .env.

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@localhost:5432/billeasy
# DATABASE_SSL=true            # managed Postgres that needs TLS

# ---------- Authentication ----------
JWT_SECRET=your-random-64-character-secret-string
JWT_ACCESS_SECRET=your-random-64-character-access-secret

# ---------- Server ----------
PORT=8001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Charis OS (required) ----------
# Plans, coupons, partner codes and Razorpay payments are managed by Charis OS.
# Bill Easy refuses to start without these. HTTPS origin only, no path.
CHARIS_OS_URL=
CHARIS_OS_APP_ID=
CHARIS_OS_APP_KEY=
# CHARIS_OS_INTERNAL_HTTP=true  # only for a private service name such as http://os-api:8000

# ---------- AI (Charis assistant) ----------
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------- File storage ----------
# local (default, files under UPLOAD_ROOT) or gcs
STORAGE_DRIVER=local
UPLOAD_ROOT=./uploads
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_BUCKET_NAME=

# ---------- Email ----------
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@charisbilleasy.store
SUPPORT_EMAIL=support@charisbilleasy.store
BREVO_API_KEY=

# ---------- Other ----------
GST_API_KEY=
