# ============================================
# Main SaaS Frontend — Environment Variables
# Copy this file to .env and fill in values.
# For production, set these in Cloudflare Pages:
#   Pages → Project → Settings → Environment Variables
# ============================================

# ── Backend API ──────────────────────────────
# Railway backend URL (no trailing slash)
VITE_BACKEND_URL=https://your-main-backend.up.railway.app

# Payments: none here. Charis OS sends the Razorpay key ID with each checkout.

# ── Analytics ────────────────────────────────
# Google Analytics 4 Measurement ID
# Get from: GA4 → Admin → Data Streams → Web → Measurement ID
# Format: G-XXXXXXXXXX
# Leave blank to disable analytics
VITE_GA_MEASUREMENT_ID=

# ── Developer Admin Portal ───────────────────
VITE_ADMIN_PORTAL_URL=https://your-admin-frontend.pages.dev/admin-portal/

# ── Misc ─────────────────────────────────────
VITE_SAAS_URL=https://charisbilleasy.store
VITE_ENABLE_AI_ASSISTANT=true
